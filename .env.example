# Copy this file to .env and fill in the values: cp .env.example .env
# .env is gitignored; this example file is committed so others know what's needed.

# Postgres container (used by compose.yaml)
POSTGRES_USER=milestone
POSTGRES_PASSWORD=change-me
POSTGRES_DB=milestone_tracker
POSTGRES_PORT=5432

# Connection string for the API (Milestone 2+). Must match the values above.
DATABASE_URL=postgres://milestone:change-me@localhost:5432/milestone_tracker
