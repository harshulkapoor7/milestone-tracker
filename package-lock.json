{
  "name": "milestone-tracker",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "milestone-tracker",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@milestone/api",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@milestone/web",
      "version": "0.0.0"
    },
    "node_modules/@milestone/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@milestone/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@milestone/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@milestone/shared",
      "version": "0.0.0"
    }
  }
}
